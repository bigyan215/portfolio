# Copy this file to `.env` and fill in values (do NOT commit secrets to git)

# Server
PORT=3000

# SMTP (for sending emails via Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false # set to true if using port 465
SENDER_EMAIL=you@example.com
TO_EMAIL=you@example.com

# Google reCAPTCHA (server secret; site key is placed in index.html)
# For local testing you can use Google's test keys (don't use in production):
# Site key (in index.html): 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Secret key (below):  6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

