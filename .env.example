# Copy this file to `.env` and fill in values (do NOT commit secrets to git)

# Server
PORT=3000

# SMTP (for sending emails via Nodemailer)
# Gmail example (recommended):
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Select "Mail" and "Windows Computer" (or your device)
#   3. Copy the generated 16-char password
#   4. Fill in the values below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bigyanbudha3@gmail.com
SMTP_PASS=tdhk omld wqeh xqco
SMTP_SECURE=false
SENDER_EMAIL=bigyanbudha3@gmail.com
TO_EMAIL=bigyanbudha3@gmail.com
# Alternative SMTP provider example:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false

# Google reCAPTCHA (server secret; site key is placed in index.html)
RECAPTCHA_SECRET=your_recaptcha_secret

